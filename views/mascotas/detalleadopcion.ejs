<article class="detalle">
    <p class="etiqueta">
        <%= mascota.especie %>
    </p>
    <h1>
        <%= mascota.nombre %>
    </h1>
    <p class="Edad"><%= mascota.edad %> Años
    </p>
    <p>
        <%= mascota.descripcion %>
    </p>
    <img src=<%= mascota.imagen %> alt="" width="200" height="200">
    <a href="/Mascotas">Volver al Listado</a>
</article>